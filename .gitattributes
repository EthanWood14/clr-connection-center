# The extension hash guard (tests/shotgun-extension.test.ts) compares raw
# bytes of chrome-extension/* against hashes.json, so line endings must be
# identical on every checkout. Everything else keeps the repo default.
chrome-extension/** text eol=lf
# PNGs are binary — without this the text rule above would try to
# line-ending-normalize them and corrupt every icon on a fresh checkout.
chrome-extension/icons/*.png binary
script/build-extension.py text eol=lf
client/public/c3-shotgun-extension.zip binary
