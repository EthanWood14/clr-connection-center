{
  "manifest_version": 3,
  "name": "C3 \u2194 Bonzo Helper",
  "version": "2026.9.18",
  "description": "Log transfer/call results from Bonzo into C3, count Bonzo calls and views, and optionally Shotgun a prospect. (built for 2026.9.18 America/Los_Angeles)",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "C3 \u2194 Bonzo"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.westcapitallending.center/*",
    "https://westcapitallending.center/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://platform.getbonzo.com/*",
        "https://app.getbonzo.com/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://platform.getbonzo.com/*",
        "https://app.getbonzo.com/*"
      ],
      "js": [
        "content.js",
        "outcome-panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
